# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=AUD

# ---- Supabase (Project Settings -> API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=
# "Copy publishable key" - safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Copy secret key" - server only, never expose to the browser
SUPABASE_SECRET_KEY=

# ---- Stripe (Dashboard -> Developers -> API keys) ----
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` or the dashboard webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Paddle Billing (Developer tools -> Authentication) ----
# "sandbox" or "production"
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_xxx
PADDLE_API_KEY=pdl_sdbx_apikey_xxx
# Developer tools -> Notifications -> your destination's secret key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxx
