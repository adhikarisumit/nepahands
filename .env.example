# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Leave a payment provider's keys BLANK
# to hide it at checkout (a placeholder value would make it look configured).

# ---- Site ----
# Your live domain, e.g. https://www.nepahands.com (on Vercel it falls back to the project URL if unset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=AUD
# Timezone used to group orders by day in Analytics
NEXT_PUBLIC_STORE_TIMEZONE=Australia/Sydney

# ---- Supabase (Project Settings -> API Keys) — required ----
NEXT_PUBLIC_SUPABASE_URL=
# "Copy publishable key" - safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Copy secret key" - server only, never expose to the browser
SUPABASE_SECRET_KEY=

# ---- Stripe (Dashboard -> Developers -> API keys) — optional ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint https://YOUR_DOMAIN/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---- Paddle Billing (Developer tools -> Authentication) — optional ----
# "sandbox" or "production"
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
# Developer tools -> Notifications -> secret key of https://YOUR_DOMAIN/api/webhooks/paddle
PADDLE_WEBHOOK_SECRET=
